use std/raylib;

const SCREEN_FACTOR = 80;
const SCREEN_WIDTH = 8 * SCREEN_FACTOR;
const SCREEN_HEIGHT = 8 * SCREEN_FACTOR;

fn main() {
    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, "UV Mango");
    defer rl::close_window();

    rl::set_target_fps(60);

    shader := rl::load_shader(nil,"/Users/tnixc/Developer/MGL/examples/resources/test.fs");
    defer rl::unload_shader(shader);

    tex := rl::get_default_texture();

    while !rl::window_should_close() {
        rl::begin_drawing();
            rl::clear_background(RAYWHITE);
            rl::begin_shader_mode(shader);

            rl::set_shader_value(
                shader,
                rl::get_shader_location(shader, "time"),
                &#cast(f32, rl::get_time()),
                ShaderUniformDataType::SHADER_UNIFORM_FLOAT
            );

            rl::draw_texture_pro(
                tex,
                Rectangle { x = 0, y = 0, width = 1, height = 1 },
                Rectangle { x = 0, y = 0, width = SCREEN_WIDTH , height = SCREEN_HEIGHT  },
                Vector2 { x = 0, y = 0 },
                0, WHITE
            );

            rl::end_shader_mode();
        rl::end_drawing();
    }
}

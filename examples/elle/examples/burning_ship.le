use std/raylib;
use std/prelude;

const SCREEN_FACTOR = 80;
const SCREEN_WIDTH = 8 * SCREEN_FACTOR;
const SCREEN_HEIGHT = 8 * SCREEN_FACTOR;

fn main() {
    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, "UV Test - Fixed");
    defer rl::close_window();
    rl::set_target_fps(60);

    shader := rl::load_shader(nil,"./resources/burning_ship.fs");
    defer rl::unload_shader(shader);

    // Get the default texture to draw with proper UV coordinates
    tex := rl::get_default_texture();

    while !rl::window_should_close() {
        rl::begin_drawing();
            rl::clear_background(RED);

            rl::draw_rectangle(10, 10, 40, 40, GREEN);
            rl::begin_shader_mode(shader);
                // Draw using DrawTexturePro to get proper UV coordinates (0,0) to (1,1)
                rl::draw_texture_pro(
                    tex,
                    Rectangle { x = 0, y = 0, width = 1, height = 1 },
                    Rectangle { x = SCREEN_WIDTH / 2, y = SCREEN_HEIGHT / 2, width = 400, height = 400 },
                    Vector2 { x = 0, y = 0 },
                    0, WHITE
                );

                // Draw another one in different location
                rl::draw_texture_pro(
                    tex,
                    Rectangle { x = 0, y = 0, width = 1, height = 1 },
                    Rectangle { x = 0, y = 0, width = SCREEN_WIDTH / 2, height = SCREEN_HEIGHT / 2 },
                    Vector2 { x = 0, y = 0 },
                    0, WHITE
                );
            rl::end_shader_mode();

            // Draw something BEFORE text to see if it forces a batch flush

            //rl::draw_fps(4, 4);
            //rl::draw_text("Text test", 200, 200, 18, BLACK);
        rl::end_drawing();
    }
}

use std/raylib;
use std/prelude;

const SCREEN_WIDTH = 800;
const SCREEN_HEIGHT = 600;

fn main() {
    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, "UV Shader Test - Proper UVs");
    defer rl::close_window();
    rl::set_target_fps(60);

    shader := rl::load_shader(nil,"../resources/burning_ship.fs");
    defer rl::unload_shader(shader);

    // Use the default texture which has proper 0-1 UV mapping
    tex := rl::get_default_texture();

    while !rl::window_should_close() {
        rl::begin_drawing();
            rl::clear_background(BLACK);

            rl::begin_shader_mode(shader);
                // Draw a fullscreen quad using texture
                // This will have proper UV coordinates from (0,0) to (1,1)
                // Expected colors:
                // Bottom-left (0,0) -> vec4(0, 0, 1, 1) = blue
                // Bottom-right (1,0) -> vec4(1, 0, 1, 1) = magenta/pink
                // Top-left (0,1) -> vec4(0, 1, 1, 1) = cyan
                // Top-right (1,1) -> vec4(1, 1, 1, 1) = white
                rl::draw_texture_pro(
                    tex,
                    Rectangle { x = 0, y = 0, width = 1, height = 1 },
                    Rectangle { x = 0, y = 0, width = SCREEN_WIDTH, height = SCREEN_HEIGHT },
                    Vector2 { x = 0, y = 0 },
                    0, WHITE
                );
            rl::end_shader_mode();

            //rl::draw_text("Expected: Blue->Cyan (left), Magenta->White (right)", 10, SCREEN_HEIGHT - 30, 20, WHITE);
            rl::draw_fps(10, 10);
        rl::end_drawing();
    }
}
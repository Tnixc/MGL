#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct fragment_3_out
{
    float4 finalColor [[color(0)]];
};

struct fragment_3_in
{
    float2 fragTexCoord [[user(locn0)]];
};

fragment fragment_3_out fragment_3(fragment_3_in in [[stage_in]], constant float& time [[buffer(0)]])
{
    fragment_3_out out = {};
    float2 uv = in.fragTexCoord;
    uv -= float2(0.5);
    float angle = (time * 0.300000011920928955078125) * 3.141590118408203125;
    float2x2 rotationMatrix = float2x2(float2(cos(angle), -sin(angle)), float2(sin(angle), cos(angle)));
    uv *= rotationMatrix;
    uv += float2(0.5);
    out.finalColor = float4(uv, 0.0, 1.0);
    return out;
}


